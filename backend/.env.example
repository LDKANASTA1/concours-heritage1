# =====================================================================
# CONCOURS DES AMBASSADEURS DE LA PROMOTION - COMPLEXE SCOLAIRE HERITAGE 1
# Copiez ce fichier en ".env" puis remplacez CHAQUE valeur ci-dessous.
# Ne committez JAMAIS le fichier .env réel dans Git (voir .gitignore).
# =====================================================================

# --- Base de données ---
# En développement, laissez la valeur SQLite par défaut : aucune configuration requise.
# En production, remplacez par l'URL PostgreSQL fournie par votre hébergeur
# (ex: ElephantSQL -> onglet "Details" -> "URL").
# Format PostgreSQL : postgresql://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=sqlite:///./heritage1.db

# --- ImgBB (upload des photos de profil) ---
# Créez une clé gratuite sur https://api.imgbb.com/ puis collez-la ici.
IMGBB_API_KEY=REMPLACEZ_PAR_VOTRE_CLE_IMGBB

# --- Sécurité JWT ---
# Générez une chaîne aléatoire longue, par ex avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACEZ_PAR_UNE_CLE_ALEATOIRE_LONGUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Support et contact ---
SUPPORT_EMAIL=ldkanasta@gmail.com
SUPPORT_PHONE=+243826740490
SUPPORT_WHATSAPP_URL=https://wa.me/243826740490

# --- SMTP (envoi d'emails via Gmail) ---
# Utilisez un "mot de passe d'application" Gmail (pas votre mot de passe habituel) :
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REMPLACEZ_PAR_VOTRE_EMAIL@gmail.com
SMTP_PASSWORD=REMPLACEZ_PAR_VOTRE_MOT_DE_PASSE_APPLICATION
SMTP_FROM=ldkanasta@gmail.com
# Mettre à "false" pour désactiver complètement l'envoi d'emails (utile en dev)
SMTP_ENABLED=true

# --- URLs ---
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5500

# --- Environnement ---
ENVIRONMENT=development
DEBUG=true

# --- École ---
NOM_ECOLE=Complexe Scolaire HERITAGE 1
PAYS=République Démocratique du Congo
